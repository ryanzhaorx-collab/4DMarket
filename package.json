{
  "name": "four-dimension-space",
  "private": true,
  "version": "1.0.0",
  "description": "四维空间 · 实景空间探索器（3DGS + 倾斜摄影移动端渲染引擎）",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "dev": "vite --host 0.0.0.0 --port 5178",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5178",
    "serve": "node scripts/serve.mjs",
    "assets": "node tools/gen-scene.mjs",
    "lod": "node tools/ply-to-lod.mjs",
    "check": "npm run typecheck && npm run lint",
    "lint": "eslint src tools scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.mjs\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.md\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playcanvas/splat-transform": "^3.11.1",
    "eslint": "^8.57.1",
    "prettier": "^3.10.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^7.2.0",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playcanvas": "^2.24.0"
  }
}
