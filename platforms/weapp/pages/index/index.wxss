.boot {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  background: radial-gradient(circle at 50% 42%, #0b1017, #04060a 72%);
  padding: 60rpx;
}
.ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(227, 199, 126, 0.18);
  border-top-color: #e3c77e;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.title { font-size: 34rpx; letter-spacing: 10rpx; color: #efe3c4; }
.sub { font-size: 22rpx; letter-spacing: 4rpx; color: rgba(237, 230, 214, 0.42); }
.err-title { font-size: 36rpx; color: #f4e7c6; }
.err-sub { font-size: 24rpx; color: #c9bda0; text-align: center; }
.tip { font-size: 22rpx; color: #8d8577; text-align: center; line-height: 1.6; }
.btn {
  margin-top: 12rpx;
  width: 520rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #221704;
  background: linear-gradient(150deg, #f6e5b8, #ddbe72 55%, #c79a3e);
}
.btn.ghost {
  color: #cfc5ae;
  background: transparent;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}
